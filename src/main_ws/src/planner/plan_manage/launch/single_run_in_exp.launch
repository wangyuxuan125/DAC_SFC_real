<launch>
    <!-- Single-vehicle DAC-SFC real-flight entry point. -->
    <arg name="drone_id" default="0"/>
    <arg name="start_px4ctrl" default="true"/>
    <arg name="start_odom_visualization" default="false"/>

    <!-- Real-flight interfaces. -->
    <arg name="odom_topic" default="/vins_fusion/imu_propagate"/>
    <arg name="depth_topic" default="/camera/depth/image_rect_raw"/>
    <arg name="cmd_topic" default="/iris_0/position_cmd"/>
    <arg name="takeoff_land_topic" default="/iris_0/takeoff_land"/>
    <arg name="mavros_ns" default="/mavros"/>

    <!-- Map and camera calibration from the current onboard setup. -->
    <arg name="map_size_x" default="100.0"/>
    <arg name="map_size_y" default="100.0"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="cx" default="322.23828125"/>
    <arg name="cy" default="236.23106384277344"/>
    <arg name="fx" default="391.30706787109375"/>
    <arg name="fy" default="391.30706787109375"/>

    <!-- Validated DAC-SFC active-flight profile. -->
    <arg name="dac_sfc_shadow_only" default="false"/>
    <!-- Production defaults: keep synchronous CSV I/O and RViz publishers off. -->
    <arg name="dac_sfc_log_enabled" default="false"/>
    <arg name="dac_sfc_visualization_enabled" default="false"/>
    <arg name="dac_sfc_fallback_to_ego" default="false"/>
    <arg name="dac_sfc_log_directory" default="/tmp/dac_sfc_deployment"/>
    <arg name="dac_sfc_max_corridor_retries" default="1"/>
    <arg name="dac_sfc_max_dynamic_retries" default="2"/>
    <arg name="dac_sfc_max_optimizer_restarts" default="1"/>
    <arg name="dac_sfc_corridor_penalty_scale" default="100.0"/>
    <arg name="dac_sfc_dynamic_penalty_scale" default="10.0"/>
    <arg name="dac_sfc_max_final_corridor_violation" default="0.002"/>
    <arg name="dac_sfc_acceleration_weight" default="10000.0"/>
    <arg name="dac_sfc_optimizer_piece_length" default="0.75"/>
    <arg name="dac_sfc_align_terminal_velocity_with_route" default="true"/>
    <arg name="dac_sfc_overlap_radius" default="0.02"/>
    <arg name="planning_horizon" default="5.0"/>
    <arg name="max_vel" default="1.0"/>
    <arg name="max_acc" default="2.0"/>

    <!-- 1: accept /goal_with_id; 2: execute the waypoint list below. -->
    <arg name="flight_type" default="1"/>
    <arg name="point_num" default="1"/>
    <arg name="target0_x" default="10.0"/>
    <arg name="target0_y" default="0.0"/>
    <arg name="target0_z" default="1.0"/>
    <arg name="target1_x" default="0.0"/>
    <arg name="target1_y" default="0.0"/>
    <arg name="target1_z" default="0.0"/>
    <arg name="target2_x" default="0.0"/>
    <arg name="target2_y" default="0.0"/>
    <arg name="target2_z" default="0.0"/>
    <arg name="target3_x" default="0.0"/>
    <arg name="target3_y" default="0.0"/>
    <arg name="target3_z" default="0.0"/>
    <arg name="target4_x" default="0.0"/>
    <arg name="target4_y" default="0.0"/>
    <arg name="target4_z" default="0.0"/>

    <include file="$(find ego_planner)/launch/include/advanced_param_exp.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="dac_sfc_shadow_only" value="$(arg dac_sfc_shadow_only)"/>
        <arg name="dac_sfc_log_enabled" value="$(arg dac_sfc_log_enabled)"/>
        <arg name="dac_sfc_visualization_enabled" value="$(arg dac_sfc_visualization_enabled)"/>
        <arg name="dac_sfc_fallback_to_ego" value="$(arg dac_sfc_fallback_to_ego)"/>
        <arg name="dac_sfc_log_directory" value="$(arg dac_sfc_log_directory)"/>
        <arg name="dac_sfc_max_corridor_retries" value="$(arg dac_sfc_max_corridor_retries)"/>
        <arg name="dac_sfc_max_dynamic_retries" value="$(arg dac_sfc_max_dynamic_retries)"/>
        <arg name="dac_sfc_max_optimizer_restarts" value="$(arg dac_sfc_max_optimizer_restarts)"/>
        <arg name="dac_sfc_corridor_penalty_scale" value="$(arg dac_sfc_corridor_penalty_scale)"/>
        <arg name="dac_sfc_dynamic_penalty_scale" value="$(arg dac_sfc_dynamic_penalty_scale)"/>
        <arg name="dac_sfc_max_final_corridor_violation" value="$(arg dac_sfc_max_final_corridor_violation)"/>
        <arg name="dac_sfc_acceleration_weight" value="$(arg dac_sfc_acceleration_weight)"/>
        <arg name="dac_sfc_optimizer_piece_length" value="$(arg dac_sfc_optimizer_piece_length)"/>
        <arg name="dac_sfc_align_terminal_velocity_with_route" value="$(arg dac_sfc_align_terminal_velocity_with_route)"/>
        <arg name="dac_sfc_overlap_radius" value="$(arg dac_sfc_overlap_radius)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="camera_pose_topic" value="null"/>
        <arg name="depth_topic" value="$(arg depth_topic)"/>
        <arg name="cx" value="$(arg cx)"/>
        <arg name="cy" value="$(arg cy)"/>
        <arg name="fx" value="$(arg fx)"/>
        <arg name="fy" value="$(arg fy)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="max_acc" value="$(arg max_acc)"/>
        <arg name="max_jer" value="20.0"/>
        <arg name="planning_horizon" value="$(arg planning_horizon)"/>
        <arg name="use_multitopology_trajs" value="true"/>
        <arg name="flight_type" value="$(arg flight_type)"/>
        <arg name="point_num" value="$(arg point_num)"/>
        <arg name="point0_x" value="$(arg target0_x)"/>
        <arg name="point0_y" value="$(arg target0_y)"/>
        <arg name="point0_z" value="$(arg target0_z)"/>
        <arg name="point1_x" value="$(arg target1_x)"/>
        <arg name="point1_y" value="$(arg target1_y)"/>
        <arg name="point1_z" value="$(arg target1_z)"/>
        <arg name="point2_x" value="$(arg target2_x)"/>
        <arg name="point2_y" value="$(arg target2_y)"/>
        <arg name="point2_z" value="$(arg target2_z)"/>
        <arg name="point3_x" value="$(arg target3_x)"/>
        <arg name="point3_y" value="$(arg target3_y)"/>
        <arg name="point3_z" value="$(arg target3_z)"/>
        <arg name="point4_x" value="$(arg target4_x)"/>
        <arg name="point4_y" value="$(arg target4_y)"/>
        <arg name="point4_z" value="$(arg target4_z)"/>
    </include>

    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server"
          type="traj_server" output="screen">
        <remap from="/position_cmd" to="$(arg cmd_topic)"/>
        <remap from="~planning/trajectory"
               to="/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~heartbeat" to="/traj_server/heartbeat"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>

    <node if="$(arg start_odom_visualization)"
          pkg="odom_visualization" name="drone_$(arg drone_id)_odom_visualization"
          type="odom_visualization" output="screen">
        <remap from="~odom" to="$(arg odom_topic)"/>
        <param name="color/a" value="1.0"/>
        <param name="color/r" value="1.0"/>
        <param name="color/g" value="0.0"/>
        <param name="color/b" value="0.0"/>
        <param name="covariance_scale" value="100.0"/>
        <param name="robot_scale" value="0.5"/>
        <param name="tf45" value="false"/>
        <param name="drone_id" value="$(arg drone_id)"/>
    </node>

    <!-- Disable this include when px4ctrl is already running elsewhere. -->
    <include if="$(arg start_px4ctrl)"
             file="$(find px4ctrl)/launch/multi_node.launch">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="cmd_topic" value="$(arg cmd_topic)"/>
        <arg name="takeoff_land_topic" value="$(arg takeoff_land_topic)"/>
        <arg name="mavros_ns" value="$(arg mavros_ns)"/>
    </include>
</launch>
