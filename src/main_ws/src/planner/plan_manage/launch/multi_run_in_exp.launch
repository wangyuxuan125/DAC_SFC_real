<launch>
    <!-- size of map, change the size inflate x, y, z according to your application -->
    <arg name="map_size_x" value="100.0"/>
    <arg name="map_size_y" value="100.0"/>
    <arg name="map_size_z" value=" 3.0"/>
    <!-- <arg name="odom_topic" value="visual_slam/odom" /> -->

    <!-- <node pkg ="assign_goals" name ="assign_goals_node" type ="assign_goals_node" output = "screen"/> -->

    <!-- Group for drone_0 -->
    <group ns="iris_0">
        <!--无人机id-->
        <arg name="drone_id" value="0"/>
        <!--飞行方式选择 1rviz 指点 2航点-->
        <arg name="flight_type" default="1"/>
        <!--航点数量-->
        <arg name="point_num" default="1"/>
        <arg name="target0_x" default="10.0"/>
        <arg name="target0_y" default="0.0"/>
        <arg name="target0_z" default="1.5"/>
        <arg name="target1_x" default="0.0"/>
        <arg name="target1_y" default="0.0"/>
        <arg name="target1_z" default="0.0"/>
        <arg name="target2_x" default="0.0"/>
        <arg name="target2_y" default="0.0"/>
        <arg name="target2_z" default="0.0"/>
        <arg name="target3_x" default="0.0"/>
        <arg name="target3_y" default="0.0"/>
        <arg name="target3_z" default="0.0"/>
        <arg name="target4_x" default="0.0"/>
        <arg name="target4_y" default="0.0"/>
        <arg name="target4_z" default="0.0"/>
        <!-- topic of your odometry such as VIO or LIO -->
        <arg name="odom_topic" value="/vins_fusion/imu_propagate"/>
        <arg name="depth_topic" value="/camera/depth/image_rect_raw"/>
        <arg name="cmd_topic" value="position_cmd"/>
        <!-- main algorithm params -->
        <include file="$(find ego_planner)/launch/include/advanced_param_gazebo.xml">
            <arg name="drone_id" value="$(arg drone_id)"/>
            <arg name="map_size_x_" value="$(arg map_size_x)"/>
            <arg name="map_size_y_" value="$(arg map_size_y)"/>
            <arg name="map_size_z_" value="$(arg map_size_z)"/>
            <arg name="odometry_topic" value="$(arg odom_topic)"/>
            <!-- camera pose: transform of camera frame in the world frame -->
            <!-- depth topic: depth image, 640x480 by default -->
            <!-- don't set cloud_topic if you already set these ones! -->
            <arg name="camera_pose_topic" value="null"/>
            <arg name="depth_topic" value="$(arg depth_topic)"/>
            <!-- topic of point cloud measurement, such as from LIDAR  -->
            <!-- don't set camera pose and depth, if you already set this one! -->
            <!-- <arg name="cloud_topic" value="null"/> -->
            <!-- intrinsic params of the depth camera -->
            <arg name="cx" value="323.3316345214844"/>
            <arg name="cy" value="234.95498657226562"/>
            <arg name="fx" value="384.39654541015625"/>
            <arg name="fy" value="384.39654541015625"/>
            <!-- maximum velocity, acceleration and jerk the drone will reach -->
            <arg name="max_vel" value="1.5" />
            <arg name="max_acc" value="3.0" />
            <arg name="max_jer" value="20.0" />
            <!--always set to 1.5 times grater than sensing horizen-->
            <arg name="planning_horizon" value="7.5" />
            <arg name="use_multitopology_trajs" value="true" />
            <!-- 1: use 2D Nav Goal to select goal  -->
            <!-- 2: use global waypoints below  -->
            <arg name="flight_type" value="$(arg flight_type)" />
            <!-- global waypoints -->
            <!-- It generates a piecewise min-snap traj passing all waypoints -->
            <arg name="point_num" value="$(arg point_num)" />
            <arg name="point0_x" value="$(arg target0_x)" />
            <arg name="point0_y" value="$(arg target0_y)" />
            <arg name="point0_z" value="$(arg target0_z)" />
            <arg name="point1_x" value="$(arg target1_x)" />
            <arg name="point1_y" value="$(arg target1_y)" />
            <arg name="point1_z" value="$(arg target1_z)" />
            <arg name="point2_x" value="$(arg target2_x)" />
            <arg name="point2_y" value="$(arg target2_y)" />
            <arg name="point2_z" value="$(arg target2_z)" />
            <arg name="point3_x" value="$(arg target3_x)" />
            <arg name="point3_y" value="$(arg target3_y)" />
            <arg name="point3_z" value="$(arg target3_z)" />
            <arg name="point4_x" value="$(arg target4_x)" />
            <arg name="point4_y" value="$(arg target4_y)" />
            <arg name="point4_z" value="$(arg target4_z)" />
        </include>
        <!-- trajectory server -->
        <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
            
            <remap from="~position_cmd" to="$(arg cmd_topic)"/>
            <remap from="position_cmd"  to="$(arg cmd_topic)"/>
            <remap from="/position_cmd" to="$(arg cmd_topic)"/>
            
            <!-- <remap from="~planning/trajectory" to="planning/trajectory"/> -->
            <remap from="~planning/trajectory" to="/drone_$(arg drone_id)_planning/trajectory"/>
            <remap from="~heartbeat" to="traj_server/heartbeat"/>
            <!-- <remap from="~planning/heartbeat" to="/drone_$(arg drone_id)_traj_server/heartbeat"/> -->
            <param name="traj_server/time_forward" value="1.0" type="double"/>
        </node>
        <!--odom visualization-->
        <node pkg="odom_visualization" name="drone_$(arg drone_id)_odom_visualization" type="odom_visualization" output="screen">
            <remap from="~odom" to="$(arg odom_topic)"/>
            <param name="color/a" value="1.0"/>    
            <param name="color/r" value="1.0"/>        
            <param name="color/g" value="0.0"/>        
            <param name="color/b" value="0.0"/>       
            <param name="covariance_scale" value="100.0"/>       
            <param name="robot_scale" value="0.5"/>
            <param name="tf45" value="false"/>
            <param name="drone_id" value="$(arg drone_id)"/>
        </node>
        <!-- manual take over -->
        <include file="$(find manual_take_over)/launch/take_over_drone.launch">
            <arg name="drone_id" value="$(arg drone_id)"/>
            <arg name="cmd_topic" value="drone_$(arg drone_id)_planning/pos_cmd"/>
        </include>
        <!-- swarm topic transmitter bridge-->
        <node pkg="swarm_bridge" name="drone_$(arg drone_id)_bridge_node" type="bridge_node_udp" output="screen">
            <!-- <remap from="~my_odom"         to="vins_estimator/imu_propagate"/> -->
            <remap from="~my_odom"         to="$(arg odom_topic)"/>
            <remap from="/goal_brig2plner"  to="/goal_with_id"/>
            <remap from="/broadcast_traj_to_planner"   to="/broadcast_traj_to_planner"/>
            <remap from="/broadcast_traj_from_planner" to="/broadcast_traj_from_planner"/>
            <param name="broadcast_ip" value="192.168.50.255" />
            <!-- <param name="broadcast_ip" value="$(arg broadcast_ip)" type="string"/> -->
            <remap from="~my_map_cloud" to="/iris_$(arg drone_id)/local_swarm_cloud"/>
            <param name="drone_id" value="$(arg drone_id)"/>
            <param name="odom_max_freq" value="70"/>
        </node>

        <node pkg="swarm_bridge" name="traj2odom_node" type="traj2odom_node" output="screen">
            <param name="odom_hz" value="30"/>
            <remap from="/broadcast_traj_to_planner" to="/broadcast_traj_to_planner"/>
            <remap from="/others_odom" to="others_odom"/>
        </node>

        <!-- 局部地图截取 + 降采样节点 -->
        <node pkg="swarm_mapping_tools" type="local_map_slice_node" name="local_map_slice_node" output="screen">
        <!-- 订阅 EGO 的障碍点云 -->
        <remap from="~input_cloud" to="/iris_$(arg drone_id)/drone_$(arg drone_id)_ego_planner_node/grid_map/occupancy"/>
        <!-- 输出给 bridge 使用 -->
        <remap from="~local_swarm_cloud" to="/iris_$(arg drone_id)/local_swarm_cloud"/>
        <!-- 里程计话题（可按实际改） -->
        <param name="odom_topic"  value="/vins_fusion/imu_propagate"/>
        <!-- 参数 -->
        <param name="max_radius"  value="10.0"/>  <!-- 截取半径 R -->
        <param name="voxel_size"  value="0.3"/>  <!-- 降采样分辨率 -->
        <param name="z_min"       value="-1.0"/>
        <param name="z_max"       value="5.0"/> 
        </node>
    </group>

</launch> 