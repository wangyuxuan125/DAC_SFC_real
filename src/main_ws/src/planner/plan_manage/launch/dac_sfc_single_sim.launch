<launch>
    <!-- Complete single-vehicle simulation stack. PX4_Firmware must already
         be present in ROS_PACKAGE_PATH so that $(find px4) resolves. -->
    <arg name="gui" default="true"/>
    <arg name="debug" default="false"/>
    <arg name="verbose" default="false"/>
    <arg name="paused" default="false"/>
    <arg name="vehicle" default="iris"/>
    <arg name="sdf" default="iris_realsense_camera"/>
    <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/ego.world"/>
    <!-- Forwarded to the planner include for deliberate active testing. -->
    <arg name="dac_sfc_shadow_only" default="true"/>
    <arg name="dac_sfc_fallback_to_ego" default="true"/>
    <arg name="max_vel" default="1.5"/>
    <arg name="max_acc" default="3.0"/>
    <arg name="planning_horizon" default="7.5"/>

    <!-- Gazebo, PX4 SITL, vehicle spawn, MAVROS and px4ctrl. -->
    <include file="$(find px4ctrl)/launch/run_mavros_gazebo.launch">
        <arg name="gui" value="$(arg gui)"/>
        <arg name="debug" value="$(arg debug)"/>
        <arg name="verbose" value="$(arg verbose)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="sdf" value="$(arg sdf)"/>
        <arg name="world" value="$(arg world)"/>
    </include>

    <!-- EGO/DAC-SFC planner, trajectory server and visualization. -->
    <include file="$(find ego_planner)/launch/single_run_in_gazebo.launch">
        <arg name="dac_sfc_shadow_only" value="$(arg dac_sfc_shadow_only)"/>
        <arg name="dac_sfc_fallback_to_ego" value="$(arg dac_sfc_fallback_to_ego)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="max_acc" value="$(arg max_acc)"/>
        <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    </include>
    <include file="$(find ego_planner)/launch/rviz.launch"/>
</launch>
