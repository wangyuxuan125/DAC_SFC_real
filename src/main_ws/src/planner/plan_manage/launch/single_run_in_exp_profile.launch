<launch>
    <!-- Profiling profile: keep visualization off, enable one fresh CSV session. -->
    <arg name="start_px4ctrl" default="true"/>

    <include file="$(find ego_planner)/launch/single_run_in_exp.launch">
        <arg name="start_px4ctrl" value="$(arg start_px4ctrl)"/>
        <arg name="start_odom_visualization" value="false"/>
        <arg name="dac_sfc_log_enabled" value="true"/>
        <arg name="dac_sfc_visualization_enabled" value="false"/>
    </include>
</launch>
