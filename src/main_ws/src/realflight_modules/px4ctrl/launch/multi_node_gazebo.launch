<launch>
    <!-- Three instances of the flight-validated PX4Ctrl for PX4 SITL vehicles 0..2. -->
    <!-- PX4 SITL reports MPC_THR_HOVER=0.5 for the Iris model. -->
    <arg name="hover_percentage" default="0.5"/>
    <!-- MAVROS local_position/odom supplies base_link-frame linear velocity. -->
    <arg name="odom_velocity_in_body" default="true"/>

    <include file="$(find px4ctrl)/launch/multi_node.launch">
        <arg name="node_name" value="px4ctrl_0"/>
        <arg name="odom_topic" value="/iris_0/mavros/local_position/odom"/>
        <arg name="cmd_topic" value="/iris_0/position_cmd_local"/>
        <arg name="takeoff_land_topic" value="/iris_0/takeoff_land"/>
        <arg name="mavros_ns" value="/iris_0/mavros"/>
        <arg name="debug_topic" value="/debugPx4ctrl_0"/>
        <arg name="hover_percentage" value="$(arg hover_percentage)"/>
        <arg name="odom_velocity_in_body" value="$(arg odom_velocity_in_body)"/>
    </include>

    <include file="$(find px4ctrl)/launch/multi_node.launch">
        <arg name="node_name" value="px4ctrl_1"/>
        <arg name="odom_topic" value="/iris_1/mavros/local_position/odom"/>
        <arg name="cmd_topic" value="/iris_1/position_cmd_local"/>
        <arg name="takeoff_land_topic" value="/iris_1/takeoff_land"/>
        <arg name="mavros_ns" value="/iris_1/mavros"/>
        <arg name="debug_topic" value="/debugPx4ctrl_1"/>
        <arg name="hover_percentage" value="$(arg hover_percentage)"/>
        <arg name="odom_velocity_in_body" value="$(arg odom_velocity_in_body)"/>
    </include>

    <include file="$(find px4ctrl)/launch/multi_node.launch">
        <arg name="node_name" value="px4ctrl_2"/>
        <arg name="odom_topic" value="/iris_2/mavros/local_position/odom"/>
        <arg name="cmd_topic" value="/iris_2/position_cmd_local"/>
        <arg name="takeoff_land_topic" value="/iris_2/takeoff_land"/>
        <arg name="mavros_ns" value="/iris_2/mavros"/>
        <arg name="debug_topic" value="/debugPx4ctrl_2"/>
        <arg name="hover_percentage" value="$(arg hover_percentage)"/>
        <arg name="odom_velocity_in_body" value="$(arg odom_velocity_in_body)"/>
    </include>
</launch>
